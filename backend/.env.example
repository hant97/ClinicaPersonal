# Copiar como .env para desarrollo local. Spring Boot lo carga automáticamente.
# Nunca guardar valores reales en este archivo ni en Git.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clinica_db
DB_USER=postgres
DB_PASSWORD=<contraseña-local>
JWT_SECRET=<secreto-base64-de-al-menos-32-bytes>
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.*:*,http://10.*:*,http://172.*:*
AUTH_MAX_ACTIVE_REFRESH_TOKENS=5
