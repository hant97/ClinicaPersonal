# Copiar como .env para desarrollo local. Spring Boot lo carga automáticamente.
# Nunca guardar valores reales en este archivo ni en Git.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/clinica_db
DB_USER=postgres
DB_PASSWORD=<contraseña-local>
# DB_HOST, DB_PORT y DB_NAME son opcionales para el backend (solo se usan si no se define
# SPRING_DATASOURCE_URL), pero scripts/backup-database.ps1|sh sí los usa para armar la
# conexión local por defecto cuando no se le pasa una cadena de conexión explícita.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinica_db
JWT_SECRET=<secreto-base64-de-al-menos-32-bytes>
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://192.168.*:*,http://10.*:*,http://172.*:*
AUTH_MAX_ACTIVE_REFRESH_TOKENS=5

# Proxies de confianza para X-Forwarded-For (regex de Tomcat). Si no se define, se confía en
# redes privadas y loopback. En red local sin proxy puede restringirse a loopback:
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=127\.\d{1,3}\.\d{1,3}\.\d{1,3}|0:0:0:0:0:0:0:1
# Activar solo una vez para incorporar una base existente que no tenga historial de Flyway.
# FLYWAY_BASELINE_ON_MIGRATE=true

# Almacenamiento de archivos (fotos, documentos, logos, imágenes del sitio).
# local: disco; usar una ruta absoluta para no depender del directorio de arranque.
STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=C:/ruta/absoluta/ClinicaPersonal/uploads
# s3: bucket privado compatible con S3. Ejemplo para Cloudflare R2:
# STORAGE_PROVIDER=s3
# STORAGE_S3_BUCKET=clinica-archivos
# STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_S3_REGION=auto
# STORAGE_S3_ACCESS_KEY=<access-key-id>
# STORAGE_S3_SECRET_KEY=<secret-access-key>

# Google Calendar Integration (Opcional en local/pre, configurable para producción)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=tu-correo-o-calendar-id@gmail.com
GOOGLE_CALENDAR_CREDENTIALS_PATH=./backend/google-credentials.json
# GOOGLE_CALENDAR_CREDENTIALS_JSON={"type":"service_account",...} (para entornos cloud como Render)
APP_TIMEZONE=America/Lima
GOOGLE_CALENDAR_SEND_NOTIFICATIONS=false

# Recordatorios de cita por correo (Opcional; si SMTP_HOST está vacío no se envían)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
APPOINTMENT_REMINDER_CRON=0 30 9 * * *
APPOINTMENT_REMINDER_LEAD_DAYS=1
APP_PUBLIC_BASE_URL=http://localhost:4200

