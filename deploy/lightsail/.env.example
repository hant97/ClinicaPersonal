# Copiar a .env en el servidor. No guardar secretos en Git.
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-neon>/<base-clinica>?sslmode=require
DB_USER=<usuario-neon-clinica>
DB_PASSWORD=<contrasena-neon-clinica>
JWT_SECRET=<mismo-secreto-de-render-si-se-desea-mantener-las-sesiones>
CORS_ALLOWED_ORIGINS=https://clinicapersonal.pages.dev
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
APP_PUBLIC_BASE_URL=https://clinicapersonal.pages.dev
